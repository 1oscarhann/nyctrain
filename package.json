{
  "name": "headway-new-york",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Headway: New York — a subway builder and transit simulation set in the real five boroughs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/build-data.ts",
    "data:synthetic": "tsx scripts/build-data.ts --synthetic",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/headless.test.ts",
    "test:headless": "vitest run tests/headless.test.ts",
    "sim": "tsx scripts/headless-sim.ts"
  },
  "dependencies": {
    "@deck.gl/core": "~9.2.11",
    "@deck.gl/extensions": "~9.2.11",
    "@deck.gl/layers": "~9.2.11",
    "@deck.gl/mapbox": "~9.2.11",
    "@fontsource/overpass": "^5.3.0",
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^5.24.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
